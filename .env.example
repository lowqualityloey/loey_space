# ==============================================================================
# SAFE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual private keys.
# DO NOT commit your real '.env' file to Git!
# ==============================================================================

# OpenWeather API (Weather Dashboard)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAI API (Optional AI Extensions)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini API (Primary AI Provider)
GEMINI_API_KEY=your_gemini_api_key_here
