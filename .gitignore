# Obsidian local workplace states & caches
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace*
.obsidian/cache/
.obsidian/indexed*
.obsidian/graph.json
# 🔌 Obsidian plugin runtime configuration (local-only, may hold secrets/state)
# Distributable plugin code (main.js, manifest.json, styles.css) stays tracked.
# Sanitized example defaults stay trackable (none ship today):
.obsidian/plugins/*/data.json
.obsidian/plugins/*/cache.json
.obsidian/plugins/*/reference-files/
!.obsidian/plugins/*/data.example.json
.trash/

# 🤖 Local AI Indices & Plugin Caches
.smart-env/
.claudian/

# 🛠️ Agent & Tool Runtime (local-only, never commit)
.omo/
.opencode/
.codegraph/
.opencode/node_modules/
.clinerules/

# 🧭 Local-only engineering layer — never published (owner decision 2026-10-04, reinstated 2026-10-08)
#
# The PromptKit OS engine is tracked as a submodule so the workflow revision is
# versioned and reproducible, but its session, spec and task records are local-only:
# they name private repositories, owner paths and internal process, which a PKM user
# cloning this product repo has no use for.
#
# These rules are STRUCTURAL, not advisory. Deletion does not remove content from
# git history, so the boundary has to hold before the commit rather than after it.
PROMPTKIT.md
docs/
GEMINI.md
.github/ISSUE_TEMPLATE/task.md
#
# ⚠️  AGENTS.md, CLAUDE.md and CODEX.md ARE tracked, so ignore rules cannot protect
#    them. The PromptKit directive block appended to each one is a working-tree change
#    only — never stage it, and strip it before opening any PR that touches those files.

# GitButler state lives in .git/ (never tracked by definition) — belt-and-suspenders:
.git/gitbutler/
.git/butler/

# 🔒 SECRETS & SENSITIVE KEYS (NEVER COMMIT TO GIT)
.secrets/
00-Private/
*.env
*.env.*
*_secret*
*_private*
!.env.example

