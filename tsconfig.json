{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./06-Resources/scripts/dist",
    "rootDir": "./06-Resources/scripts/src"
  },
  "include": [
    "06-Resources/scripts/src/**/*"
  ]
}
