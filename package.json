{
  "name": "loey-space-scripts",
  "version": "1.0.0",
  "description": "TypeScript scripts and automation for loey_space Obsidian vault",
  "private": true,
  "bin": {
    "heyloey": "06-Resources/scripts/heyloey.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check-bundles": "node check-bundle-parity.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node -e \"const fs=require('fs'),cp=require('child_process');const files=fs.readdirSync('06-Resources/scripts/tests').filter(f=>f.endsWith('.test.mjs')).sort().map(f=>'06-Resources/scripts/tests/'+f);process.exit(cp.spawnSync(process.execPath,['node_modules/tsx/dist/cli.mjs','--test',...files],{stdio:'inherit'}).status??1)\"",
    "audit-links": "node 06-Resources/scripts/audit-links.js",
    "distill": "node 06-Resources/scripts/distill-concept-action.js",
    "log-github": "node 06-Resources/scripts/sync-github-activity.js",
    "reconcile-github": "node 06-Resources/scripts/reconcile-github-milestones.mjs",
    "start-task": "node 06-Resources/scripts/start-task-action.js",
    "sync-kanban": "node 06-Resources/scripts/sync-github-kanban.js",
    "validate-templates": "node 06-Resources/scripts/validate-templates.js",
    "hygiene": "node 06-Resources/scripts/vault-hygiene.js",
    "heyloey": "node 06-Resources/scripts/heyloey.js",
    "check-rot": "node 06-Resources/scripts/vault-hygiene.js --check-rot",
    "init:vault": "node 06-Resources/scripts/vault-init.js",
    "backup": "node 06-Resources/scripts/backup-vault.js",
    "patch-homepulse": "node 06-Resources/scripts/apply-homepulse-prelude.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "0.20.2",
    "obsidian": "^1.5.7",
    "tsx": "4.23.15",
    "typescript": "^5.3.3"
  }
}
