#!/usr/bin/env bash
#
# pre-commit — stops secrets entering Git history.
#
# Why a hook and not CI: a GitHub Action runs *after* the push, by which point a
# leaked key is already public and must be rotated. This blocks the commit on
# your machine, before anything leaves it.
#
# Activate once per clone:
#     git config core.hooksPath .githooks
#
# Checks, in order:
#   0. Publication boundary — declared owner-only records, staged (blocking) and
#                            already-indexed (advisory). See #116 / .githooks/lib/private-records.txt
#   1. Forbidden paths   — .env, .secrets/, 00-Private/, *_secret*, *_private*
#   2. Added-line content — API-key shapes (Google, OpenAI, GitHub, AWS, PEM)
#   3. Advisory          — sensitive files already tracked from earlier commits
#
# Placeholders such as "your_key_here" are allowed, so .env.example and the
# docs that quote it still commit cleanly.
#
# Deliberate override (you own the consequences):  git commit --no-verify

set -uo pipefail

RED=''; YELLOW=''; DIM=''; RESET=''
if [ -t 2 ]; then
  RED=$'\033[31m'; YELLOW=$'\033[33m'; DIM=$'\033[2m'; RESET=$'\033[0m'
fi

fail=0
problems=()

# Repo root, so the publication guard can resolve its declaration list the same way the
# hook does — a hook run from a subdirectory must behave identically.
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
guard="$(dirname "$0")/lib/publication-guard.sh"

# ---------------------------------------------------------------------------
# 0. Publication boundary — declared owner-only records (issue #116 / audit A01)
#
# Separate defect class from the checks below: those match credential *shapes*, while a
# root control record leaks identity and context — a real name, a filesystem path, a
# project inventory — which has no shape to match. And .gitignore never untracks a file,
# so a record can be named private and still publish. Runs before the empty-stage fast
# path below, because the index advisory must fire even on a commit with nothing staged.
#
# Rejection prints paths only, never contents.
# ---------------------------------------------------------------------------
if ! bash "$guard" --repo "$repo_root" --mode staged; then
  exit 1
fi

# Advisory, not blocking: records already in the index publish on the *next* push, not
# with this commit, and refusing every commit until they are untracked would stall
# unrelated work. It is the same reasoning as section 3's already-tracked warning.
if ! index_guard_output="$(bash "$guard" --repo "$repo_root" --mode index 2>&1)"; then
  {
    echo ""
    echo "${YELLOW}⚠ Declared owner-only records are already tracked:${RESET}"
    printf '%s\n' "$index_guard_output" | grep -E '^  • ' || true
    echo "  They publish on the next push. Fix: git rm --cached <path> — the local copy"
    echo "  stays on disk and the .gitignore rules then hold."
    echo ""
  } >&2
fi

# ---------------------------------------------------------------------------
# Staged files (added/copied/modified), NUL-separated so paths with spaces
# survive — this vault is full of them ("Second Brain Guide.md").
# ---------------------------------------------------------------------------
mapfile -d '' -t staged < <(git diff --cached --name-only --diff-filter=ACMR --find-renames -z 2>/dev/null)
if [ "${#staged[@]}" -eq 0 ]; then
  exit 0
fi

# ---------------------------------------------------------------------------
# 1. Forbidden paths
# ---------------------------------------------------------------------------
for file in "${staged[@]}"; do
  [ -n "$file" ] || continue

  case "$file" in
    # .env.example stays committable as a placeholder template; its CONTENT
    # is still scanned in section 2 (only the path block is skipped here).
    .env.example|*/.env.example)
      continue
      ;;
    .env|*/.env|.env.*|*/.env.*)
      problems+=("${file} — environment file (keys belong here, not in Git)")
      fail=1
      ;;
    # Env-variant parity with .gitignore (*.env, *.env.*): service.env and
    # nested variants are sensitive too. .env.example stays committable via
    # the continue clause above; its content is still scanned in section 2.
    *.env|*.env.*)
      problems+=("${file} — environment-file variant (keys belong here, not in Git)")
      fail=1
      ;;
    .secrets/*|*/.secrets/*)
      problems+=("${file} — private notes directory")
      fail=1
      ;;
    00-Private/*|*/00-Private/*)
      problems+=("${file} — private folder")
      fail=1
      ;;
    *_secret*|*_private*)
      problems+=("${file} — filename marked secret/private")
      fail=1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# 2. Content of ADDED lines only
#    Scanning just the additions avoids re-flagging text that already exists,
#    and keeps the check fast on a vault this size.
# ---------------------------------------------------------------------------

# Patterns and matching live in .githooks/lib/secret-scan.sh so this hook and
# the CI scan step can never drift apart. Fail closed: without the library the
# content check would silently degrade to path checks only.
# shellcheck source=.githooks/lib/secret-scan.sh
if ! . "$(dirname "$0")/lib/secret-scan.sh"; then
  {
    echo ""
    echo "✖ Commit blocked — .githooks/lib/secret-scan.sh is missing"
    echo "  Content scanning cannot run; refusing to allow a partial check."
    echo ""
  } >&2
  exit 1
fi

for file in "${staged[@]}"; do
  [ -n "$file" ] || continue
  scan_skips_path "$file" && continue

  # Added lines only, minus the +++ header and minus inline font/image blob
  # lines (base64 runs can contain key-shaped substrings; narrow carve-out).
  added=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep -E '^\+' | grep -Ev '^\+\+\+|data:(font|image)/') || true
  [ -n "$added" ] || continue

  hits=$(printf '%s\n' "$added" | scan_text "$file") || true
  if [ -n "$hits" ]; then
    while IFS= read -r hit; do
      [ -n "$hit" ] || continue
      problems+=("$hit")
    done <<< "$hits"
    fail=1
  fi
done

# ---------------------------------------------------------------------------
# 3. Advisory: already-tracked sensitive files (from before this hook existed)
# ---------------------------------------------------------------------------
tracked_bad=$(git ls-files -- '.env' '.secrets/*' '00-Private/*' 2>/dev/null | grep -v '\.env\.example$') || true

# ---------------------------------------------------------------------------
# Report
# ---------------------------------------------------------------------------
if [ "$fail" -ne 0 ]; then
  {
    echo ""
    echo "${RED}✖ Commit blocked — possible secrets staged${RESET}"
    echo ""
    for problem in "${problems[@]}"; do
      echo "  • ${problem}"
    done
    echo ""
    echo "${YELLOW}How to fix${RESET}"
    echo "  1. Unstage it:            git restore --staged <file>"
    echo "  2. Keep keys in .env      (git-ignored) and commit .env.example instead"
    echo "  3. Already pushed once?   Rotate the key — history rewrites do not un-leak it"
    echo ""
    echo "${DIM}Intentional? git commit --no-verify${RESET}"
    echo ""
  } >&2
  exit 1
fi

if [ -n "$tracked_bad" ]; then
  {
    echo ""
    echo "${YELLOW}⚠ Sensitive files are already tracked from earlier commits:${RESET}"
    printf '  • %s\n' $tracked_bad
    echo "  Consider: git rm --cached <file>  — and rotate anything that was pushed."
    echo ""
  } >&2
fi

exit 0
